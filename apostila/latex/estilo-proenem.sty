\newcommand{\abresubcapitulo}[3]{%
  \begin{tcolorbox}[
      enhanced,
      colback=white,
      colframe=white,
      boxrule=0pt,
      left=0pt,right=0pt,top=4pt,bottom=7pt,
      borderline south={1.2pt}{0pt}{petroleo}]
    {\fontsize{23}{26}\selectfont\bfseries\color{petroleoescuro}#1\par}
    \vspace{2pt}
    {\large\color{cinza}#2\par}
    \vspace{8pt}
    {\footnotesize\bfseries\color{petroleo}#3}
  \end{tcolorbox}
}

